{
  "name": "origami-css",
  "version": "0.0.1",
  "description": "Experiments with custom elements",
  "license": "MIT",
  "types": "origami.d.ts",
  "style": "src/",
  "scripts": {
    "build-types": "bun scripts/build-types.ts",
    "build-docs": "NODE_ENV=production bun site/buildMarkdown.ts",
    "build-dist": "bun build --minify --outfile=dist/bundle.css ./src/all.css",
    "build-site": "bun run build-docs && bun build --minify --outdir=dist/ ./site/index.html",
    "dev": "bun run --hot ./site/server.ts",
    "lint": "biome lint --write",
    "start": "bun dev",
    "ts": "tsgo --noEmit",
    "test": "bun scripts/build-types.ts --check && biome lint && bun tsc && bun test"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "github.com/af/origami"
  },
  "keywords": [
    "css",
    "custom-elements"
  ],
  "author": "Aaron Franks (http://aaronfranks.com/)",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "marked": "18.0.6",
    "typescript": "7.0.2"
  }
}
