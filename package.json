{
  "name": "origami",
  "version": "0.0.1",
  "description": "Experiments with custom elements",
  "license": "MIT",
  "types": "origami.d.ts",
  "style": "src/",
  "scripts": {
    "build-dist": "bun build --minify --outfile=dist/bundle.css ./src/all.css",
    "build-playground": "bun build --minify --outdir=dist/ ./playground/index.html",
    "dev": "bun run --hot ./playground/server.ts",
    "lint": "biome lint --write",
    "tsc": "tsc --noEmit",
    "test": "biome lint && bun tsc"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "github.com/af/origami"
  },
  "keywords": [
    "css",
    "custom-elements"
  ],
  "author": "Aaron Franks (http://aaronfranks.com/)",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "marked": "^18.0.3",
    "@typescript/native-preview": "^7.0.0-dev.20260503.1"
  }
}
