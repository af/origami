{
  "name": "origami",
  "version": "0.0.1",
  "description": "Experiments with custom elements",
  "license": "MIT",
  "types": "origami.d.ts",
  "style": "src/",
  "scripts": {
    "build-dist": "bun build --minify --outfile=dist/bundle.css ./src/all.css",
    "build-site": "bun build --minify --outdir=dist/ ./site/index.html",
    "dev": "bun run --hot ./site/server.ts",
    "lint": "biome lint --write",
    "start": "bun dev",
    "ts": "tsgo --noEmit",
    "test": "biome lint && bun tsc"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "github.com/af/origami"
  },
  "keywords": [
    "css",
    "custom-elements"
  ],
  "author": "Aaron Franks (http://aaronfranks.com/)",
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "marked": "18.0.5",
    "@typescript/native-preview": "7.0.0-dev.20260613.1"
  }
}
